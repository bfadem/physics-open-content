        "unit": "m/s"
      },
      "m0": {
        "desc": "initial mass",
        "unit": "kg"
      },
      "mf": {
        "desc": "final mass",
        "unit": "kg"
      }
    },
    "answer_expression": "u*log(m0/mf)",
    "answer_unit": "m/s",
    "given": {
      "u": "2500",
      "m0": "1000",
      "mf": "400"
    },
    "expected_value": 2290.73,
