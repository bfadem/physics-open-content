  {
    "id": "mech-004",
    "topic": "spring launch speed (guard: difference of derived-unit terms under a root)",
    "tier": "multi-step",
    "statement": "A block of mass m sits on a vertical spring of stiffness k compressed by x, then is released. Find its speed when the spring reaches its natural length.",
    "symbols": {
      "k": {
        "desc": "spring constant",
        "unit": "N/m"
      },
      "x": {
        "desc": "initial compression",
        "unit": "m"
      },
      "m": {
        "desc": "block mass",
        "unit": "kg"
      },
      "g": {
        "desc": "gravitational acceleration",
        "unit": "m/s^2"
      }
    },
    "answer_expression": "sqrt(k*x^2/m - 2*g*x)",
    "answer_unit": "m/s",
    "given": {
      "k": "800",
      "x": "0.10",
      "m": "0.20",
      "g": "9.81"
    },
    "expected_value": 6.16749,
    "limits": [
      {
        "symbol": "g",
        "to": "0",
        "expect": "x*sqrt(k/m)"
      }
    ]
  },
  {
    "id": "mech-005",
    "topic": "hinge force on a cable-supported beam (guard: limits equal only on the physical domain, Abs(sin) and sqrt of a square)",
    "tier": "multi-step",
    "statement": "A uniform horizontal beam of mass m_b and length L is hinged to a wall at its left end. A cable from its right end to the wall above the hinge makes angle theta (0 < theta < pi/2) with the beam. A block of mass m_w hangs from the beam at distance d (d < L) from the hinge. Find the magnitude of the force the hinge exerts on the beam.",
    "symbols": {
      "m_b": {
        "desc": "beam mass",
        "unit": "kg"
      },
      "L": {
        "desc": "beam length",
        "unit": "m"
      },
      "m_w": {
        "desc": "hanging mass",
        "unit": "kg"
      },
      "d": {
        "desc": "distance of hanging mass from hinge",
        "unit": "m"
      },
      "theta": {
        "desc": "cable angle above the beam",
        "unit": "rad"
      },
      "g": {
        "desc": "gravitational acceleration",
        "unit": "m/s^2"
      }
    },
    "answer_expression": "g*sqrt((cos(theta)/sin(theta)*(m_b/2 + m_w*d/L))^2 + (m_b/2 + m_w*(1 - d/L))^2)",
    "answer_unit": "N",
    "given": {
      "m_b": "12.0",
      "L": "3.0",
      "m_w": "20.0",
      "d": "2.0",
      "theta": "0.6",
      "g": "9.81"
    },
    "expected_value": 303.8,
    "limits": [
      {
        "symbol": "m_w",
        "to": "0",
        "expect": "m_b*g/(2*sin(theta))"
      },
      {
        "symbol": "theta",
        "to": "pi/2",
        "expect": "g*(m_b/2 + m_w*(1 - d/L))"
      }
    ]
  },
