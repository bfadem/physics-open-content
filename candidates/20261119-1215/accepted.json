    "topic": "Magnitude of piston displacement during isobaric heating of an ideal gas",
    "statement": "A vertical cylinder with cross-sectional area area_a contains n_moles of an ideal gas. A piston of mass mass_p rests on top of the gas in equilibrium. The piston is free to move vertically without friction. The external atmospheric pressure is p_ext. If the gas is heated from an initial temperature t_1 to a final temperature t_2, find the magnitude of the displacement of the piston. Use gas_R for the universal gas constant and g for the acceleration due to gravity.",
    "symbols": {
      "area_a": {
        "desc": "cross-sectional area of the cylinder",
        "unit": "m^2"
      },
      "n_moles": {
        "desc": "amount of gas in moles",
        "unit": "mol"
      },
      "mass_p": {
        "desc": "mass of the piston",
        "unit": "kg"
      },
      "p_ext": {
        "desc": "external atmospheric pressure",
        "unit": "Pa"
      },
      "t_1": {
        "desc": "initial temperature of the gas",
        "unit": "K"
      },
      "t_2": {
        "desc": "final temperature of the gas",
        "unit": "K"
      },
      "gas_R": {
        "desc": "universal gas constant",
        "unit": "J/(mol*K)"
      },
      "g": {
        "desc": "acceleration due to gravity",
        "unit": "m/s^2"
      }
    },
    "answer_expression": "n_moles * gas_R * (t_2 - t_1) / (area_a * p_ext + mass_p * g)",
    "answer_unit": "m",
    "given": {
      "area_a": "0.01",
      "n_moles": "0.5",
      "mass_p": "2.0",
      "p_ext": "101325.0",
      "t_1": "300.0",
      "t_2": "400.0",
      "gas_R": "8.314",
      "g": "9.81"
    },
    "limits": [
      {
        "symbol": "t_2",
        "to": "t_1",
        "expect": "0"
      },
      {
        "symbol": "n_moles",
        "to": "0",
        "expect": "0"
      }
    ],
    "expected_value": 0.402471,
    "solver_expression": "n_moles*gas_R*(t_2 - t_1)/(area_a*(p_ext + mass_p*g/area_a))"
  },
