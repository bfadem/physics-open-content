      "M": {
        "desc": "total mass of the annular disk",
        "unit": "kg"
      },
      "R_out": {
        "desc": "outer radius of the disk",
        "unit": "m"
      },
      "R_in": {
        "desc": "inner radius of the concentric hole",
        "unit": "m"
      }
    },
    "answer_expression": "M*(R_out**2 + R_in**2)/2",
    "answer_unit": "kg*m^2",
